{
    "name": "bs-manager",
    "description": "Manage maps, mods and more for Beat Saber",
    "version": "1.6.0",
    "packageManager": "pnpm@10.34.4",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "10.34.4",
            "onFail": "error"
        }
    },
    "scripts": {
        "preinstall": "node .erb/scripts/require-pnpm.cjs",
        "build-rust-scripts": "tsx ./.erb/scripts/build-rust-scripts.js",
        "lint": "cross-env NODE_ENV=development eslint . --ext .js,.jsx,.ts,.tsx",
        "dev:tauri": "vite --config vite.config.mts --host 127.0.0.1 --port 1420 --strictPort",
        "build:tauri:ui": "tsc --project tsconfig.tauri-contracts.json --noEmit --pretty false && vite build --config vite.config.mts",
        "tauri": "tauri",
        "build:tauri:win": "pnpm run build-rust-scripts && pnpm run build:tauri:ui && tauri build --target x86_64-pc-windows-msvc --config src-tauri/tauri.preview.conf.json --bundles nsis && node scripts/collect-tauri-installer.mjs preview",
        "build:tauri:win:replacement": "pnpm run build-rust-scripts && pnpm run build:tauri:ui && tauri build --target x86_64-pc-windows-msvc --config src-tauri/tauri.replacement.conf.json --bundles nsis && node scripts/collect-tauri-installer.mjs replacement",
        "test": "jest --testRegex \"src[\\\\/]__tests__[\\\\/].*\\.test\\.ts$\"",
        "test:unit": "jest ./src/__tests__/unit",
        "update:patreon": "tsx ./.erb/scripts/update-patreon.js"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "cross-env NODE_ENV=development eslint --cache"
        ],
        "*.json,.{eslintrc,prettierrc}": [
            "prettier --ignore-path .eslintignore --parser json --write"
        ],
        "*.{css,scss}": [
            "prettier --ignore-path .eslintignore --single-quote --write"
        ],
        "*.{html,md,yml}": [
            "prettier --ignore-path .eslintignore --single-quote --write"
        ]
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Zagrios/bs-manager.git"
    },
    "author": {
        "name": "Zagrios",
        "email": "peroz.mathieu@gmail.com",
        "url": "https://github.com/Zagrios"
    },
    "contributors": [],
    "license": "GPL-3.0-only",
    "bugs": {
        "url": "https://github.com/Zagrios/bs-manager/issues"
    },
    "keywords": [
        "downgrade",
        "launcher-application",
        "beatsaber",
        "beat-saber"
    ],
    "homepage": "https://github.com/Zagrios/bs-manager#readme",
    "devDependencies": {
        "@react-types/shared": "3.30.0",
        "@tauri-apps/cli": "^2.12.3",
        "@testing-library/jest-dom": "^6.4.1",
        "@testing-library/react": "^14.2.0",
        "@types/color": "^3.0.3",
        "@types/crypto-js": "^4.2.1",
        "@types/dateformat": "^5.0.0",
        "@types/jest": "^29.5.11",
        "@types/node": "^24.13.3",
        "@types/react": "^18.0.33",
        "@types/react-dom": "^18.0.11",
        "@types/react-outside-click-handler": "^1.3.1",
        "@types/react-test-renderer": "^18.0.7",
        "@types/react-virtualized-auto-sizer": "^1.0.1",
        "@types/react-window": "^1.8.5",
        "@types/semver": "^7.8.0",
        "@types/use-double-click": "^1.0.4",
        "@typescript-eslint/eslint-plugin": "^6.20.0",
        "@typescript-eslint/parser": "^6.20.0",
        "@vitejs/plugin-react": "^5.2.0",
        "autoprefixer": "^10.4.17",
        "chalk": "^4.1.2",
        "cross-env": "^10.1.0",
        "detect-port": "^2.1.0",
        "eslint": "^8.56.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-config-erb": "^4.1.0",
        "eslint-import-resolver-typescript": "^3.6.1",
        "eslint-plugin-compat": "^4.2.0",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-jest": "^27.6.3",
        "eslint-plugin-jsx-a11y": "^6.8.0",
        "eslint-plugin-promise": "^6.1.1",
        "eslint-plugin-react": "^7.33.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^29.7.0",
        "lint-staged": "^16.4.0",
        "opencollective-postinstall": "^2.0.3",
        "postcss": "^8.5.16",
        "prettier": "^3.2.4",
        "react-test-renderer": "^18.2.0",
        "rimraf": "^5.0.5",
        "sass": "^1.70.0",
        "tailwindcss": "^3.4.12",
        "ts-jest": "^29.1.2",
        "ts-node": "^10.9.2",
        "tsx": "^4.19.2",
        "typescript": "5.3.3",
        "vite": "^7.3.6"
    },
    "dependencies": {
        "@emotion/is-prop-valid": "1.4.0",
        "@hello-pangea/dnd": "^18.0.1",
        "@heroui/date-picker": "2.3.22",
        "@heroui/radio": "2.3.21",
        "@heroui/system": "2.4.18",
        "@heroui/theme": "2.4.17",
        "@internationalized/date": "^3.5.4",
        "@tauri-apps/api": "^2.12.4",
        "@tippyjs/react": "^4.2.6",
        "clsx": "^2.1.1",
        "color": "^5.0.0",
        "crypto-js": "^4.2.0",
        "dateformat": "^5.0.3",
        "dot-prop": "^9.0.0",
        "fast-deep-equal": "^3.1.3",
        "format-duration": "^3.0.2",
        "framer-motion": "^12.42.2",
        "history": "^5.3.0",
        "qrcode.react": "^4.2.0",
        "react": "^18.2.0",
        "react-colorful": "^5.6.1",
        "react-dom": "^18.2.0",
        "react-range": "^1.10.0",
        "react-router-dom": "^6.24.1",
        "react-virtualized-auto-sizer": "^1.0.25",
        "react-window": "^1.8.11",
        "rfdc": "^1.4.1",
        "rxjs": "^7.8.2",
        "semver": "7.7.3",
        "serialize-error": "^12.0.0",
        "striptags": "^4.0.0-alpha.4",
        "tailwind-merge": "^3.0.2",
        "tailwindcss-scoped-groups": "^2.0.0",
        "tippy.js": "^6.3.7",
        "use-double-click": "^1.0.5",
        "use-fit-text": "^2.4.0"
    },
    "engines": {
        "node": ">=24 <25"
    },
    "overrides": {
        "@typescript-eslint/typescript-estree": {
            "minimatch": "^9.0.9"
        }
    },
    "collective": {
        "url": "https://www.patreon.com/bsmanager"
    },
    "browserslist": [],
    "prettier": {
        "printWidth": 1000,
        "bracketSameLine": false,
        "arrowParens": "avoid",
        "semi": true,
        "singleQuote": false,
        "jsxSingleQuote": false,
        "trailingComma": "es5",
        "bracketSpacing": true,
        "tabWidth": 4,
        "overrides": [
            {
                "files": [
                    ".prettierrc",
                    ".eslintrc"
                ],
                "options": {
                    "parser": "json"
                }
            }
        ]
    }
}
