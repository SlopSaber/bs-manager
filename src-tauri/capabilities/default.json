{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "main-capability",
    "description": "Local application UI capability",
    "windows": ["main", "launcher", "oneclick-download-map", "oneclick-download-playlist", "oneclick-download-model", "shortcut-launch"],
    "permissions": [
        "core:default",
        "dialog:allow-open",
        "dialog:allow-save",
        "opener:allow-open-url",
        "notification:default",
        "store:default",
        "window-state:default"
    ]
}
