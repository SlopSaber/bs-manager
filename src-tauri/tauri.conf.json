{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "BSManager Preview",
    "version": "1.6.0",
    "identifier": "io.bsmanager.bsmanager.preview",
    "build": {
        "beforeDevCommand": "pnpm run dev:tauri",
        "devUrl": "http://127.0.0.1:1420",
        "frontendDist": "../release/tauri/ui"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "BSManager Preview",
                "url": "index.html",
                "width": 1080,
                "height": 720,
                "minWidth": 900,
                "minHeight": 500,
                "center": true,
                "resizable": true,
                "decorations": false,
                "visible": true,
                "dragDropEnabled": true
            }
        ],
        "security": {
            "csp": "default-src 'self' asset:; img-src 'self' asset: data: https: http:; style-src 'self' 'unsafe-inline' https://use.typekit.net https://p.typekit.net; font-src 'self' data: https://use.typekit.net https://p.typekit.net; script-src 'self'; connect-src ipc: http://ipc.localhost https: http: ws: wss:; frame-src https:; media-src 'self' asset: blob: data:"
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": ["../build/icons/win/favicon.ico"],
        "category": "Game",
        "shortDescription": "Manage maps, mods and Beat Saber versions",
        "resources": [
            "../assets/jsons/bs-versions.json",
            "../assets/jsons/patreons.json",
        "../assets/proto/song_details_cache_v1.proto",
        "../assets/scripts/bs-downloader.exe"
        ],
        "windows": {
            "nsis": {
                "installMode": "currentUser",
                "displayLanguageSelector": false
            },
            "webviewInstallMode": {
                "type": "downloadBootstrapper"
            }
        }
    },
    "plugins": {
        "deep-link": {
            "desktop": {
                "schemes": []
            }
        }
    }
}
